# Copy to .env (cp .env.example .env) and replace EVERY "change-me" value.
# Generate strong secrets with:  openssl rand -hex 32
# Never commit .env (it is in .gitignore).

# Your domain, e.g. smartingest.example.com. Use :80 to test on a laptop over plain http.
DOMAIN=:80

# Database: admin user (maintenance only) and the restricted user the API uses
POSTGRES_USER=smartingest_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartingest
APP_DB_PASSWORD=change-me

# Bronze (raw files): "local" keeps them on a Docker volume on this server.
# "s3" uses any S3-compatible service (AWS S3, Cloudflare R2, Backblaze B2).
BRONZE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Your personal admin key (32+ characters). Send it as the X-API-Key header.
ADMIN_API_KEY=change-me

# Claude (optional). Leave empty for rule-only mode.
ANTHROPIC_API_KEY=
SMARTINGEST_FAST_MODEL=claude-haiku-4-5-20251001
SMARTINGEST_SMART_MODEL=claude-sonnet-5-5

# Public demo
DEMO_MODE=true
DEMO_LLM_ENABLED=true
# Hard cap on Claude calls per day across all visitors (protects your API bill)
LLM_DAILY_CALL_LIMIT=300
